[
  {
    "name": "สันเขื่อน + ลาดชนดินราบ (Right)",
    "surface": [{ "x": -30, "y": -3 }, { "x": 30, "y": -3 }],
    "spec": {
      "className": "CrestRight", "namespace": "TestSubassembly",
      "params": [
        { "name": "Side", "kind": "long", "default": 0 },
        { "name": "Width", "kind": "double", "default": 3, "displayName": "ความกว้างสัน", "min": 0.5 },
        { "name": "SideSlope", "kind": "double", "default": 2 }
      ],
      "targets": [{ "name": "TargetSurface", "type": "Surface", "displayName": "Target Surface" }],
      "points": [
        { "id": "P1", "codes": ["Crown"], "def": { "type": "origin" } },
        { "id": "P2", "codes": ["EdgeTop"], "def": { "type": "delta", "from": "P1", "dx": "Width", "dy": "0" } },
        { "id": "P3", "codes": [], "def": { "type": "slopeLength", "from": "P2", "slope": "-1/SideSlope", "length": "sqrt(5)", "dir": 1, "measure": "along" } },
        { "id": "P4", "codes": ["Daylight"], "def": { "type": "slopeToSurface", "from": "P3", "slope": "-1/SideSlope", "dir": 1, "target": "TargetSurface", "maxDistance": "50", "layoutLength": "3" } },
        { "id": "P5", "codes": [], "def": { "type": "delta", "from": "P1", "dx": "0", "dy": "-3" } }
      ],
      "links": [
        { "id": "L1", "points": ["P1", "P2"], "codes": ["Top", "Datum"] },
        { "id": "L2", "points": ["P2", "P3"], "codes": ["Side"] },
        { "id": "L3", "points": ["P3", "P4"], "codes": ["Daylight"] },
        { "id": "L4", "points": ["P4", "P5"], "codes": ["Datum"] },
        { "id": "L5", "points": ["P5", "P1"], "codes": [] }
      ],
      "shapes": [{ "id": "S1", "links": ["L1", "L2", "L3", "L4", "L5"], "codes": ["Fill"] }],
      "side": { "param": "Side", "mirror": true }
    }
  },
  {
