<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the round 6 subassemblies against the installed Civil 3D 2027. Run build-c3d.bat at the repository root. -->
  <PropertyGroup>
    <!-- Civil 3D 2027 runs on .NET 10 (see acdbmgd.runtimeconfig.json in the install folder) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SaRound6</AssemblyName>
    <RootNamespace>TestSubassembly</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>out\</OutputPath>
    <C3DInstall Condition="'$(C3DInstall)' == ''">C:\Program Files\Autodesk\AutoCAD 2027\</C3DInstall>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\pavement-assembly.cs" />
    <Compile Include="..\..\base_rock-pitching-web.cs" />
    <Compile Include="..\..\body_rock-pitching-web.cs" />
  </ItemGroup>

  <!-- Autodesk DLLs are referenced in place: never copied to the output, never committed -->
  <ItemGroup>
    <Reference Include="acdbmgd"><HintPath>$(C3DInstall)acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="accoremgd"><HintPath>$(C3DInstall)accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(C3DInstall)acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AecBaseMgd"><HintPath>$(C3DInstall)ACA\AecBaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AeccDbMgd"><HintPath>$(C3DInstall)C3D\AeccDbMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
