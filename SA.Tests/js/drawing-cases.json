  {
    "name": "between / intersect / measure dx-dy / ฟังก์ชันในนิพจน์",
    "surface": [{ "x": -30, "y": -3 }, { "x": 30, "y": -3 }],
    "values": { "H": 2.5 },
    "spec": {
      "className": "Funcs",
      "params": [{ "name": "Side", "kind": "long", "default": 0 }, { "name": "H", "kind": "double", "default": 2 }, { "name": "Ang", "kind": "double", "default": 30 }],
      "targets": [],
      "points": [
        { "id": "P1", "codes": [], "def": { "type": "origin" } },
        { "id": "P2", "codes": [], "def": { "type": "delta", "from": "P1", "dx": "max(H, 1) * 2 - -1", "dy": "-(H - 0.5) / 2" } },
        { "id": "P3", "codes": [], "def": { "type": "slopeLength", "from": "P1", "slope": "-tan(Ang)", "length": "H", "dir": 1, "measure": "dx" } },
        { "id": "P4", "codes": [], "def": { "type": "slopeLength", "from": "P2", "slope": "-1/2", "length": "pow(H, 2) / 4", "dir": -1, "measure": "dy" } },
        { "id": "P5", "codes": ["Mid"], "def": { "type": "between", "a": "P1", "b": "P2", "t": "0.5" } },
        { "id": "P6", "codes": ["X"], "def": { "type": "intersect", "a1": "P1", "a2": "P3", "b1": "P2", "b2": "P4" } },
        { "id": "P7", "codes": [], "def": { "type": "delta", "from": "P6", "dx": "atan(1) / 45 + abs(-0.5) + min(3, 2, H)", "dy": "cos(60) - sin(30)" } }
      ],
      "links": [
        { "id": "L1", "points": ["P1", "P2"], "codes": ["A"] },
        { "id": "L2", "points": ["P3", "P6"], "codes": ["B"] },
        { "id": "L3", "points": ["P6", "P7"], "codes": [] }
      ],
      "shapes": [],
      "side": { "param": "Side", "mirror": true }
    }
  },
