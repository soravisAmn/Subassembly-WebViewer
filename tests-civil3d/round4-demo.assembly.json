{
  "version": 1,
  "name": "Round4 demo",
  "baseline": { "x": 0, "y": 0 },
  "originElevation": 100,
  "surface": [{ "x": -20, "y": -4 }, { "x": -6, "y": -2.5 }, { "x": 0, "y": -1 }, { "x": 6, "y": -1.6 }, { "x": 20, "y": 2 }],
  "surfaceOn": true,
  "layout": false,
  "extendEnds": true,
  "items": [
    {
      "id": "round4demo",
      "name": "Round4Demo",
      "className": null,
      "params": {},
      "attach": { "type": "baseline", "x": 0, "y": 0 },
      "fileName": "round4-demo.cs",
      "spec":
{
        "version": 1, "className": "Round4Demo", "namespace": "TestSubassembly",
        "params": [
          { "name": "Side", "kind": "long", "default": 0, "displayName": "Side", "min": null, "max": null },
          { "name": "Width", "kind": "double", "default": 3, "displayName": "Width (ความกว้างบน)", "min": 0.5, "max": null },
          { "name": "CutSlope", "kind": "double", "default": 1.5, "displayName": "Cut Slope (1:x)", "min": null, "max": null },
          { "name": "FillSlope", "kind": "double", "default": 2, "displayName": "Fill Slope (1:x)", "min": null, "max": null },
          { "name": "HighFillH", "kind": "double", "default": 1.5, "displayName": "High fill above (m)", "min": null, "max": null },
          { "name": "Curb", "kind": "long", "default": 1, "displayName": "Curb (1 = มีขอบทาง)", "min": null, "max": null }
        ],
        "targets": [{ "name": "TargetSurface", "type": "Surface", "displayName": "Target Surface" }],
        "points": [
          { "id": "P1", "codes": ["Crown"], "def": { "type": "origin" } },
          { "id": "P2", "codes": ["Shoulder"], "def": { "type": "delta", "from": "P1", "dx": "Width", "dy": "-0.02 * Width" } },
          { "id": "P3", "codes": ["Daylight_Cut"], "def": { "type": "slopeToSurface", "from": "P2", "slope": "1/CutSlope", "dir": 1, "target": "TargetSurface", "maxDistance": "50", "layoutLength": "3" }, "branch": "B1" },
          { "id": "P4", "codes": ["Daylight_Fill"], "def": { "type": "slopeToSurface", "from": "P2", "slope": "-1/FillSlope", "dir": 1, "target": "TargetSurface", "maxDistance": "50", "layoutLength": "3" }, "branch": "B2" },
          { "id": "P5", "codes": ["Daylight"], "def": { "type": "firstOf", "points": ["P3", "P4"] }, "auxiliary": true },
          { "id": "P6", "codes": ["Ditch"], "def": { "type": "delta", "from": "P5", "dx": "1", "dy": "if(IsCut, -0.3, 0)" } },
          { "id": "P7", "codes": ["Guardrail"], "def": { "type": "delta", "from": "P2", "dx": "-0.3", "dy": "0.8" }, "branch": "B3" },
          { "id": "P8", "codes": ["Curb"], "def": { "type": "delta", "from": "P2", "dx": "0", "dy": "0.15" }, "branch": "B5" }
        ],
        "links": [
          { "id": "L1", "points": ["P1", "P2"], "codes": ["Top"] },
          { "id": "L2", "points": ["P2", "P3"], "codes": ["Daylight_Cut"], "branch": "B1" },
          { "id": "L3", "points": ["P2", "P4"], "codes": ["Daylight_Fill"], "branch": "B2" },
          { "id": "L4", "points": ["P3", "P6"], "codes": ["Ditch"], "branch": "B1" },
          { "id": "L5", "points": ["P4", "P6"], "codes": ["Ditch"], "branch": "B2" },
          { "id": "L6", "points": ["P2", "P7"], "codes": ["Guardrail"], "branch": "B3" },
          { "id": "L7", "points": ["P2", "P8"], "codes": ["Curb"], "branch": "B5" }
        ],
        "shapes": [],
        "logic": {
          "conditions": [
            { "id": "C1", "name": "IsCut", "expr": "ground(P2) > P2.y", "note": "ผิวดินสูงกว่าบานพับ = ตัด" },
            { "id": "C2", "name": "HighFill", "expr": "P2.y - ground(P2) > HighFillH", "note": "ถมสูงกว่า HighFillH = มีราวกันตก" }
          ],
          "decisions": [
            { "id": "D1", "parent": null, "kind": "if", "test": "IsCut", "label": "ตัดหรือถม?" },
            { "id": "D2", "parent": "B2", "kind": "if", "test": "HighFill", "label": "ถมสูงไหม?" },
            { "id": "D3", "parent": null, "kind": "switch", "test": "Curb", "label": "ขอบทาง" }
          ],
          "branches": [
            { "id": "B1", "decision": "D1", "case": true, "label": "ตัด" },
            { "id": "B2", "decision": "D1", "case": false, "label": "ถม" },
            { "id": "B3", "decision": "D2", "case": true, "label": "ถมสูง" },
            { "id": "B4", "decision": "D2", "case": false, "label": "ถมปกติ" },
            { "id": "B5", "decision": "D3", "case": 1, "label": "มีขอบทาง" },
            { "id": "B6", "decision": "D3", "case": "else", "label": "ไม่มีขอบทาง" }
          ]
        },
        "side": { "param": "Side", "mirror": true }
      }
    }
  ]
}